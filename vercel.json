{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/admin.html",
      "dest": "/customer_app/admin.html"
    },
    {
      "src": "/driver.html",
      "dest": "/customer_app/driver.html"
    },
    {
      "src": "/index.html",
      "dest": "/customer_app/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}